#!/usr/bin/env python3
"""
Local listener: subscribes to your ntfy topic and plays a sound + desktop
notification whenever a remote machine posts a job-finished event.

Run this once (e.g. in a persistent tmux pane or autostart):
    job-notify-listen
"""

import json
import subprocess
import sys
import urllib.request

TOPIC = "claude-done-73147a89"
NTFY_URL = f"https://ntfy.sh/{TOPIC}/json"


def speak(text: str):
    subprocess.Popen(["espeak-ng", "-v", "en-gb", "-s", "145", "-p", "55", text],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def desktop_notify(title: str, body: str):
    subprocess.Popen(["notify-send", "--urgency=normal", title, body],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def listen():
    print(f"Listening on ntfy.sh/{TOPIC} …  (Ctrl-C to stop)", flush=True)
    while True:
        try:
            with urllib.request.urlopen(NTFY_URL) as resp:
                for raw_line in resp:
                    line = raw_line.decode().strip()
                    if not line:
                        continue
                    try:
                        event = json.loads(line)
                    except json.JSONDecodeError:
                        continue
                    # ntfy sends keepalive "open" events — ignore them
                    if event.get("event") != "message":
                        continue
                    msg = event.get("message", "")
                    title = event.get("title", "Job finished")
                    if msg:
                        print(f"[{title}] {msg}", flush=True)
                        desktop_notify(title, msg)
                        # parse "[task] ..." prefix from message
                        task = "shell"
                        if msg.startswith("[") and "]" in msg:
                            task = msg[1:msg.index("]")]
                        speak(f"{title}, {task} is done")
        except KeyboardInterrupt:
            print("\nStopped.")
            sys.exit(0)
        except Exception as exc:
            # reconnect on network hiccups
            print(f"Connection lost ({exc}), reconnecting …", flush=True)


if __name__ == "__main__":
    listen()
