#!/usr/bin/env python3
"""
Local listener: subscribes to your ntfy topic and plays a sound + desktop
notification whenever a remote machine posts a job-finished event.

Run this once (e.g. in a persistent tmux pane or autostart):
    job-notify-listen
"""

import json
import os
import subprocess
import sys

TOPIC = "claude-done-73147a89"
NTFY_URL = f"https://ntfy.sh/{TOPIC}/json"
BASE_DIR = os.path.dirname(os.path.realpath(__file__))
CLAUDE_SOUND = os.path.join(BASE_DIR, "sounds", "local_claude.mp3")

# Per-host override: maps Title (hostname) → mp3 path
CLAUDE_SOUND_BY_HOST = {
    "Thoth": os.path.expanduser("~/Downloads/thoth_claude.mp3"),
}


def speak(text: str):
    subprocess.Popen(["espeak-ng", "-v", "en-gb", "-s", "145", "-p", "55", text],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def desktop_notify(title: str, body: str):
    subprocess.Popen(["notify-send", "--urgency=normal", title, body],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def listen():
    print(f"Listening on ntfy.sh/{TOPIC} …  (Ctrl-C to stop)", flush=True)
    while True:
        try:
            proc = subprocess.Popen(
                ["curl", "-sN", "--no-buffer", NTFY_URL],
                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
            )
            for raw_line in proc.stdout:
                line = raw_line.decode().strip()
                if not line:
                    continue
                try:
                    event = json.loads(line)
                except json.JSONDecodeError:
                    continue
                # ntfy sends keepalive "open" events — ignore them
                if event.get("event") != "message":
                    continue
                msg = event.get("message", "")
                title = event.get("title", "Job finished")
                if msg:
                    print(f"[{title}] {msg}", flush=True)
                    desktop_notify(title, msg)
                    # parse "[task] ..." prefix from message
                    task = "shell"
                    if msg.startswith("[") and "]" in msg:
                        task = msg[1:msg.index("]")]
                    if task == "claude":
                        sound = CLAUDE_SOUND_BY_HOST.get(title, CLAUDE_SOUND)
                        subprocess.Popen(["mpg123", "-q", "-o", "pulse", "--scale", "65536", sound],
                                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                    else:
                        speak(f"{task} is done")
            proc.wait()
        except KeyboardInterrupt:
            proc.terminate()
            print("\nStopped.")
            sys.exit(0)
        except Exception as exc:
            # reconnect on network hiccups
            print(f"Connection lost ({exc}), reconnecting …", flush=True)


if __name__ == "__main__":
    listen()
